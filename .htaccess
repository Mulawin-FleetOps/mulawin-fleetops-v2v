DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule ^(backend|config|database|docs|scripts|storage|tests)(/|$) - [F,L,NC]
</IfModule>
<FilesMatch "^(\.env.*|\.gitignore|.*\.sql|.*\.log|.*\.txt|.*\.md|.*\.csv|.*\.json|.*\.py|.*\.bat)$">
 Require all denied
</FilesMatch>
