DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
 RewriteEngine On
 # SECURITY_DOTPATH_BLOCK_V1: dot-directories and dot-files (.git, .github, .vscode, .env, ...) are never served.
 # /.well-known/ stays reachable (SSL certificate validation).
 RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
 RewriteRule ^(backend|config|database|docs|scripts|storage|tests|automation)(/|$) - [F,L,NC]
</IfModule>
# Same dot-path block when mod_rewrite is off (mod_alias). 403 = Forbidden, nothing is redirected.
<IfModule mod_alias.c>
 RedirectMatch 403 "/\.(?!well-known(/|$))"
</IfModule>
<FilesMatch "^(\.env.*|\.gitignore|.*\.sql|.*\.log|.*\.txt|.*\.md|.*\.csv|.*\.json|.*\.py|.*\.bat|.*\.bak)$">
 Require all denied
</FilesMatch>
