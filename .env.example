# Copy this file to ".env" in the same folder, then fill in your values.
# Never share the real .env file (it has your database password).
APP_ENV=development
APP_TIMEZONE=Asia/Manila
SESSION_NAME=rp_mulawin_fms_v2
# Minutes of no activity before the user is logged out (0 = never).
SESSION_IDLE_MINUTES=60

# Database (default XAMPP: user root, no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mulawin_v2
DB_USER=root
DB_PASS=

# Printed on forms and reports
COMPANY_NAME=R P MULAWIN TRUCKING SERVICE
COMPANY_ADDRESS=#086-A Purok 2 Brgy. Luyos Tanauan City, Batangas

# Only needed to create the FIRST Admin account in the browser
# (public/install.php). Use 32+ random characters, then clear it after setup.
INSTALL_TOKEN=

# ---------------------------------------------------------------------------
# EMAIL (password-change / email-change verification codes and notices). Free option: Gmail + App Password.
#   1. Turn on 2-Step Verification in your Google account.
#   2. Google account > Security > App passwords > create one for "Mulawin FleetOps".
#   3. Paste the 16-character App Password below (spaces are fine).
# Test with:  php scripts/test_email.php you@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# tls = STARTTLS on port 587 | ssl = port 465 | none = local test mailbox (e.g. Mailpit on 1025)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Mulawin FleetOps

# ---------------------------------------------------------------------------
# MAP (trip form, Client Routes). See docs/CLAUDE_05_OSM_ROUTING.md.
# Map tiles: OpenStreetMap (no key needed). Keep the attribution visible.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Road distance (automatic km) and address search: openrouteservice (HeiGIT), called from THIS server only.
# Free account: https://account.heigit.org  -> create an API key -> paste it below.
# The key is never sent to the browser. Leave it empty to turn automatic km off (km is typed by hand).
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org
# driving-hgv (trucks, default) or driving-car
ORS_PROFILE=driving-hgv
# Daily guards (stop below the free quota: 2,000 directions, 1,000 geocoding, 1,000 reverse per day)
ORS_DAILY_LIMIT_ROUTE=1800
ORS_DAILY_LIMIT_SEARCH=900
ORS_DAILY_LIMIT_REVERSE=900
# Map requests per user per minute
MAP_USER_PER_MINUTE=30

# ---------------------------------------------------------------------------
# TEST DATA (optional). Only to load complete test data from the browser on hosting without SSH:
# public/seed_test_data.php works only while this has 32+ random characters AND you are logged in as Admin.
# Clear it after use. With SSH or XAMPP use instead:  php scripts/seed_test_data.php
SEED_TEST_TOKEN=
